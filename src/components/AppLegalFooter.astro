---
import type { AppEntry } from '../lib/apps';

interface Props {
  entry: AppEntry;
}

const { entry } = Astro.props;
const { data } = entry;
const base = import.meta.env.BASE_URL;
const appBase = `${base}apps/${entry.id}/`;
---

<footer class="app-legal">
  {
    data.links.length > 0 && (
      <nav class="app-links" aria-label="App links">
        <ul>
          {data.links.map((link) => (
            <li>
              <a href={link.url}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    data.legalPages.length > 0 && (
      <nav class="legal-links" aria-label="Legal">
        <ul>
          {data.legalPages.map((page) => (
            <li>
              <a href={`${appBase}${page.slug}`}>{page.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {data.disclaimer && <p class="disclaimer">{data.disclaimer}</p>}
</footer>

<style>
  .app-legal {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .app-links ul,
  .legal-links ul {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }

  .app-links a,
  .legal-links a {
    text-decoration: none;
    color: var(--text-muted);
  }

  .app-links a:hover,
  .legal-links a:hover {
    color: var(--app-accent, var(--gold));
  }

  .disclaimer {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    font-style: italic;
  }
</style>
