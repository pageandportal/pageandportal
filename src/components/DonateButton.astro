---
interface Props {
  url: string;
  label?: string;
}

const { url, label = 'Support development' } = Astro.props;
---

<a class="donate-btn" href={url} target="_blank" rel="noopener noreferrer">
  {label}
</a>

<style>
  .donate-btn {
    display: inline-block;
    padding: 0.75rem 1.35rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--bg);
    background: var(--app-accent, var(--gold));
    border-radius: var(--radius);
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .donate-btn:hover {
    filter: brightness(1.08);
    color: var(--bg);
    transform: translateY(-1px);
  }

  .donate-btn:focus-visible {
    outline: 2px solid var(--app-accent, var(--gold));
    outline-offset: 3px;
  }
</style>
