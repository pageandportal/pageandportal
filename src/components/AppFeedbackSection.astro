---
import type { AppEntry } from '../lib/apps';

interface Props {
  entry: AppEntry;
}

const { entry } = Astro.props;
const { data } = entry;
const email = data.supportEmail;

if (!email) {
  return null;
}

const feedbackSubject = `${data.name} feedback`;
const mailtoUrl = `mailto:${email}?subject=${encodeURIComponent(feedbackSubject)}`;
---

<section class="feedback" id="feedback" aria-labelledby="feedback-heading">
  <h2 id="feedback-heading" class="section-title">Questions and feedback</h2>
  <div class="feedback-inner">
    <p class="feedback-lead">
      Ideas for layout, features, or bugs? James reads every message — no account or form required.
    </p>
    <a class="feedback-button" href={mailtoUrl}>
      Email {email}
    </a>
    <p class="feedback-note">
      Opens your email app with <strong>{feedbackSubject}</strong> as the subject line.
    </p>
  </div>
</section>

<style>
  .section-title {
    margin: 0 0 1rem;
    font-size: 1.35rem;
  }

  .feedback-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 42ch;
  }

  .feedback-lead {
    margin: 0;
    color: var(--text-muted);
  }

  .feedback-button {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--bg);
    background: var(--app-accent, var(--gold));
    border-radius: var(--radius);
  }

  .feedback-button:hover {
    filter: brightness(1.08);
  }

  .feedback-button:focus-visible {
    outline: 2px solid var(--app-accent, var(--gold));
    outline-offset: 3px;
  }

  .feedback-note {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .feedback-note strong {
    font-weight: 600;
    color: var(--text);
  }
</style>
