---
interface AppEntry {
  slug: string;
  name: string;
  tagline: string;
  status: string;
  subtitle?: string;
}

interface Props {
  app: AppEntry;
  iconUrl?: string;
}

const { app, iconUrl } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}apps/${app.slug}/`;
const statusLabel = app.status.replace(/-/g, ' ');
---

<article class="app-card">
  <a class="app-card-link" href={href}>
    <div class="app-card-media">
      {
        iconUrl ? (
          <img
            src={iconUrl}
            alt=""
            width="72"
            height="72"
            class="app-icon"
            decoding="async"
            aria-hidden="true"
          />
        ) : (
          <div class="app-icon-fallback" aria-hidden="true">
            {app.name.charAt(0)}
          </div>
        )
      }
    </div>
    <div class="app-card-body">
      <span class="badge">{statusLabel}</span>
      <h2 class="app-name">{app.name}</h2>
      {app.subtitle && <p class="app-subtitle">{app.subtitle}</p>}
      <p class="app-tagline">{app.tagline}</p>
    </div>
  </a>
</article>

<style>
  .app-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.2s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .app-card {
      transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .app-card:hover {
      transform: translateY(-2px);
    }
  }

  .app-card:hover {
    border-color: var(--gold-dim);
  }

  .app-card-link {
    display: flex;
    gap: 1.25rem;
    padding: 1.25rem;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius);
  }

  .app-card-link:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  .app-card-media {
    flex-shrink: 0;
  }

  .app-icon {
    border-radius: 14px;
    object-fit: cover;
  }

  .app-icon-fallback {
    width: 72px;
    height: 72px;
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--gold);
    background: rgb(197 160 89 / 10%);
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  .app-card-body {
    min-width: 0;
  }

  .app-name {
    margin: 0.5rem 0 0.25rem;
    font-size: 1.25rem;
    color: var(--text);
  }

  .app-subtitle {
    margin: 0 0 0.35rem;
    font-size: 0.85rem;
    color: var(--gold);
    font-weight: 500;
  }

  .app-tagline {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-muted);
  }
</style>
