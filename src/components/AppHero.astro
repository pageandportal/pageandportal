---
import { appAssetUrl, appIconUrl, statusLabel } from '../lib/apps';
import type { AppEntry } from '../lib/apps';

interface Props {
  entry: AppEntry;
}

const { entry } = Astro.props;
const { data } = entry;
const base = import.meta.env.BASE_URL;
const iconUrl = appIconUrl(entry.id, data.icon);
const heroUrl = appAssetUrl(data.heroImage);
/** Primary CTA: first non-mailto link (Play Store, Open app, etc.). */
const primaryCta = data.links.find(
  (link) => Boolean(link.url) && !link.url!.startsWith('mailto:'),
);
const primaryIsExternal = Boolean(
  primaryCta?.url && /^https?:\/\//i.test(primaryCta.url),
);
---

<header class="app-hero">
  <div class="container hero-top">
    <a class="back" href={base}>← Back to home</a>

    <div class:list={['hero-ident', data.wordmark && 'hero-ident-wordmark']}>
      {
        data.wordmark && iconUrl ? (
          <div class="hero-wordmark-block">
            <span class="badge">{statusLabel(data.status)}</span>
            <img
              src={iconUrl}
              alt={data.name}
              width="420"
              height="164"
              class="app-wordmark"
              decoding="async"
            />
            <h1 class="sr-only">{data.name}</h1>
            {data.subtitle && <p class="subtitle">{data.subtitle}</p>}
            <p class="tagline">{data.tagline}</p>
          </div>
        ) : (
          <>
            {
              iconUrl ? (
                <img
                  src={iconUrl}
                  alt=""
                  width="96"
                  height="96"
                  class="app-icon"
                  decoding="async"
                  aria-hidden="true"
                />
              ) : (
                <div class="app-icon-fallback" aria-hidden="true">
                  {data.name.charAt(0)}
                </div>
              )
            }
            <div class="hero-copy">
              <span class="badge">{statusLabel(data.status)}</span>
              <h1>{data.name}</h1>
              {data.subtitle && <p class="subtitle">{data.subtitle}</p>}
              <p class="tagline">{data.tagline}</p>
            </div>
          </>
        )
      }
    </div>
  </div>

  {
    heroUrl && (
      <figure class="hero-banner">
        <img
          src={heroUrl}
          alt={data.heroImageAlt ?? `${data.name} hero artwork`}
          width="1100"
          height="400"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    )
  }

  <div class="container hero-bottom">
    <p class="intro">{data.description}</p>
    {
      primaryCta?.url && (
        <p class="hero-cta">
          <a
            class="store-button"
            href={primaryCta.url}
            target={primaryIsExternal ? '_blank' : undefined}
            rel={primaryIsExternal ? 'noopener noreferrer' : undefined}
          >
            {primaryCta.label}
          </a>
        </p>
      )
    }
    {
      data.announcement && (
        <p class="hero-announcement">
          <span class="announcement-spark" aria-hidden="true">✦</span>
          <span class="announcement-text">{data.announcement}</span>
          <span class="announcement-spark" aria-hidden="true">✦</span>
        </p>
      )
    }
  </div>
</header>

<style>
  .app-hero {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-muted);
  }

  .back:hover {
    color: var(--app-accent, var(--gold));
  }

  .back:focus-visible {
    color: var(--app-accent, var(--gold));
  }

  .hero-ident {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .hero-ident-wordmark {
    display: block;
  }

  .hero-wordmark-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    max-width: 36rem;
  }

  .app-wordmark {
    display: block;
    width: min(100%, 28rem);
    height: auto;
    border-radius: 16px;
    background: #fff;
  }

  .app-icon {
    border-radius: 16px;
    flex-shrink: 0;
  }

  .app-icon-fallback {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--app-accent, var(--gold));
    background: rgb(197 160 89 / 10%);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .hero-copy h1 {
    margin: 0.5rem 0 0.25rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }

  .subtitle {
    margin: 0 0 0.35rem;
    color: var(--app-accent, var(--gold));
    font-weight: 500;
  }

  .tagline {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .hero-banner {
    position: relative;
    margin: 0;
    width: 100%;
    max-height: clamp(220px, 42vw, 440px);
    overflow: hidden;
    border-block: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .hero-banner::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 35%;
    background: linear-gradient(to top, rgb(13 15 18 / 55%), transparent);
    pointer-events: none;
  }

  .hero-banner img {
    display: block;
    width: 100%;
    height: clamp(220px, 42vw, 440px);
    object-fit: cover;
    object-position: center 40%;
  }

  .hero-bottom {
    text-align: center;
  }

  .intro {
    margin: 0 auto;
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  .hero-cta {
    margin: 1.25rem 0 0;
  }

  .store-button {
    display: inline-block;
    padding: 0.65rem 1.25rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    color: var(--bg);
    background: var(--app-accent, var(--gold));
    border-radius: var(--radius);
  }

  .store-button:hover {
    filter: brightness(1.08);
  }

  .store-button:focus-visible {
    outline: 2px solid var(--app-accent, var(--gold));
    outline-offset: 3px;
  }

  .hero-announcement {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1rem 0 0;
    padding: 0.45rem 1.1rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--app-accent, var(--gold));
    border: 1px solid var(--app-accent, var(--gold-dim));
    border-radius: 999px;
    background:
      linear-gradient(
        110deg,
        transparent 35%,
        rgb(255 255 255 / 14%) 50%,
        transparent 65%
      ),
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--app-accent-secondary, var(--gold-dim)) 35%, transparent),
        color-mix(in srgb, var(--app-accent, var(--gold)) 18%, transparent),
        color-mix(in srgb, var(--app-accent-secondary, var(--gold-dim)) 35%, transparent)
      );
    background-size:
      250% 100%,
      100% 100%;
    background-position:
      150% 0,
      0 0;
    background-repeat: no-repeat;
    box-shadow: 0 0 18px color-mix(in srgb, var(--app-accent, var(--gold)) 25%, transparent);
  }

  .announcement-spark {
    font-size: 0.8em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-announcement {
      animation: announcement-shimmer 4s ease-in-out infinite;
    }

    .announcement-spark {
      animation: announcement-twinkle 2s ease-in-out infinite;
    }

    .announcement-spark:last-child {
      animation-delay: 1s;
    }
  }

  @keyframes announcement-shimmer {
    0%,
    40% {
      background-position:
        150% 0,
        0 0;
    }

    100% {
      background-position:
        -50% 0,
        0 0;
    }
  }

  @keyframes announcement-twinkle {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(0.85);
    }

    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }
</style>
