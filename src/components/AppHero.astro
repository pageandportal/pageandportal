---
import { appAssetUrl, appIconUrl, statusLabel } from '../lib/apps';
import type { AppEntry } from '../lib/apps';

interface Props {
  entry: AppEntry;
}

const { entry } = Astro.props;
const { data } = entry;
const base = import.meta.env.BASE_URL;
const iconUrl = appIconUrl(entry.id, data.icon);
const heroUrl = appAssetUrl(data.heroImage);
---

<header class="app-hero">
  <div class="container hero-top">
    <a class="back" href={base}>← Back to home</a>

    <div class="hero-ident">
      {
        iconUrl ? (
          <img
            src={iconUrl}
            alt=""
            width="96"
            height="96"
            class="app-icon"
            decoding="async"
            aria-hidden="true"
          />
        ) : (
          <div class="app-icon-fallback" aria-hidden="true">
            {data.name.charAt(0)}
          </div>
        )
      }
      <div class="hero-copy">
        <span class="badge">{statusLabel(data.status)}</span>
        <h1>{data.name}</h1>
        {data.subtitle && <p class="subtitle">{data.subtitle}</p>}
        <p class="tagline">{data.tagline}</p>
      </div>
    </div>
  </div>

  {
    heroUrl && (
      <figure class="hero-banner">
        <img
          src={heroUrl}
          alt={data.heroImageAlt ?? `${data.name} hero artwork`}
          width="1100"
          height="400"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    )
  }

  <div class="container hero-bottom">
    <p class="intro">{data.description}</p>
  </div>
</header>

<style>
  .app-hero {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-muted);
  }

  .back:hover {
    color: var(--app-accent, var(--gold));
  }

  .back:focus-visible {
    color: var(--app-accent, var(--gold));
  }

  .hero-ident {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .app-icon {
    border-radius: 16px;
    flex-shrink: 0;
  }

  .app-icon-fallback {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--app-accent, var(--gold));
    background: rgb(197 160 89 / 10%);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .hero-copy h1 {
    margin: 0.5rem 0 0.25rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }

  .subtitle {
    margin: 0 0 0.35rem;
    color: var(--app-accent, var(--gold));
    font-weight: 500;
  }

  .tagline {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .hero-banner {
    position: relative;
    margin: 0;
    width: 100%;
    max-height: clamp(220px, 42vw, 440px);
    overflow: hidden;
    border-block: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .hero-banner::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 35%;
    background: linear-gradient(to top, rgb(13 15 18 / 55%), transparent);
    pointer-events: none;
  }

  .hero-banner img {
    display: block;
    width: 100%;
    height: clamp(220px, 42vw, 440px);
    object-fit: cover;
    object-position: center 40%;
  }

  .hero-bottom {
    text-align: center;
  }

  .intro {
    margin: 0 auto;
    font-size: 1.05rem;
    color: var(--text-muted);
  }
</style>
