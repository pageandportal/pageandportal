---
import { hasRoadmapItems, roadmapLanes } from '../lib/apps';
import type { AppEntry } from '../lib/apps';
import RoadmapCard from './RoadmapCard.astro';

interface Props {
  entry: AppEntry;
}

const { entry } = Astro.props;
const lanes = roadmapLanes(entry);
const showLanes = hasRoadmapItems(entry);

const VISIBLE_CARDS = 8;

type Item = (typeof lanes)[number]['items'][number];
type Group = { release?: string; items: Item[] };

/** Consecutive items sharing a `release` form one group; items without one form an unlabelled group. */
function groupByRelease(items: Item[]): Group[] {
  const groups: Group[] = [];
  for (const item of items) {
    const last = groups.at(-1);
    if (last && last.release === item.release) last.items.push(item);
    else groups.push({ release: item.release, items: [item] });
  }
  return groups;
}

/**
 * Split a lane into what shows straight away and what sits behind "Show more".
 * Release groups are never split: whole groups show until VISIBLE_CARDS is reached.
 */
function splitLane(items: Item[]) {
  const groups = groupByRelease(items);
  if (!groups.some((group) => group.release)) {
    return {
      visible: [{ items: items.slice(0, VISIBLE_CARDS) }],
      hidden: items.length > VISIBLE_CARDS ? [{ items: items.slice(VISIBLE_CARDS) }] : [],
    };
  }
  const visible: Group[] = [];
  const hidden: Group[] = [];
  let shown = 0;
  for (const group of groups) {
    if (visible.length === 0 || shown + group.items.length <= VISIBLE_CARDS) {
      visible.push(group);
      shown += group.items.length;
    } else {
      hidden.push(group);
    }
  }
  return { visible, hidden };
}

const count = (groups: Group[]) => groups.reduce((sum, group) => sum + group.items.length, 0);

/** Lanes that start with a release heading sit lower; the others get a matching spacer so first cards line up. */
const startsWithRelease = (items: Item[]) => Boolean(items[0]?.release);
const alignToRelease = lanes.some((lane) => startsWithRelease(lane.items));
---

<section class="roadmap" aria-labelledby="roadmap-heading">
  <h2 id="roadmap-heading" class="section-title">Roadmap</h2>

  {
    showLanes ? (
      <ul class="roadmap-lanes">
        {lanes.map((lane) => {
          const { visible, hidden } = splitLane(lane.items);
          const allReleased = lane.items.every((item) => item.status === 'shipped');
          const renderGroups = (groups: Group[], more = false) =>
            groups.map((group) => (
              <div class:list={['release-group', { 'lane-items-more': more }]}>
                {group.release && <h4 class="release-label">{group.release}</h4>}
                <ul class="lane-items">
                  {group.items.map((item) => (
                    <RoadmapCard
                      title={item.title}
                      description={item.description}
                      status={allReleased ? undefined : item.status}
                    />
                  ))}
                </ul>
              </div>
            ));
          return (
            <li class="roadmap-lane">
              <h3 class="lane-label">{lane.label}</h3>
              {alignToRelease && !startsWithRelease(lane.items) && (
                <div class="release-label release-spacer" aria-hidden="true">&nbsp;</div>
              )}
              {lane.items.length > 0 ? (
                <>
                  {renderGroups(visible)}
                  {hidden.length > 0 && (
                    <details class="lane-more">
                      <summary class="lane-more-toggle">
                        <span class="lane-more-closed">
                          Show {count(hidden)} more
                          <span class="sr-only"> in {lane.label}</span>
                        </span>
                        <span class="lane-more-open">
                          Show fewer
                          <span class="sr-only"> in {lane.label}</span>
                        </span>
                        <span class="lane-more-chevron" aria-hidden="true" />
                      </summary>
                      {renderGroups(hidden, true)}
                    </details>
                  )}
                </>
              ) : (
                <p class="lane-empty">Nothing listed yet.</p>
              )}
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="roadmap-placeholder">
        Roadmap items will appear here once they are added to the app supply sheet.
      </p>
    )
  }
</section>

<style>
  .section-title {
    margin: 0 0 1.25rem;
    font-size: 1.35rem;
  }

  .roadmap-placeholder,
  .lane-empty {
    margin: 0;
    padding: 1rem 1.25rem;
    color: var(--text-muted);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .roadmap-lanes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .roadmap-lane {
    list-style: none;
  }

  @media (min-width: 768px) {
    .roadmap-lanes {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }

  .lane-label {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    color: var(--app-accent, var(--gold));
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .lane-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .release-group + .release-group {
    margin-top: 1rem;
  }

  .release-label {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .release-spacer {
    visibility: hidden;
  }

  .lane-more {
    margin-top: 0.65rem;
  }

  .lane-more-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--app-accent, var(--gold));
    background: transparent;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
  }

  .lane-more-toggle::-webkit-details-marker {
    display: none;
  }

  .lane-more-toggle:hover {
    background: var(--bg-elevated);
    border-color: var(--app-accent, var(--gold-dim));
  }

  .lane-more-toggle:focus-visible {
    outline: 2px solid var(--app-accent, var(--gold));
    outline-offset: 3px;
  }

  .lane-more-open,
  .lane-more[open] .lane-more-closed {
    display: none;
  }

  .lane-more[open] .lane-more-open {
    display: inline;
  }

  .lane-more-chevron {
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
  }

  .lane-more[open] .lane-more-chevron {
    transform: translateY(2px) rotate(-135deg);
  }

  .lane-items-more {
    margin-top: 0.65rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lane-more-chevron {
      transition: transform 0.2s ease;
    }

    .lane-more[open] .lane-items-more {
      animation: lane-more-reveal 0.25s ease-out;
    }
  }

  @keyframes lane-more-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .roadmap-lanes {
      position: relative;
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      scroll-snap-type: x mandatory;
    }

    .roadmap-lane {
      flex: 0 0 min(85%, 280px);
      scroll-snap-align: start;
    }
  }
</style>
