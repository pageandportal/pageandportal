---
import { hasRoadmapItems, roadmapLanes } from '../lib/apps';
import type { AppEntry } from '../lib/apps';
import RoadmapCard from './RoadmapCard.astro';

interface Props {
  entry: AppEntry;
}

const { entry } = Astro.props;
const lanes = roadmapLanes(entry);
const showLanes = hasRoadmapItems(entry);

const VISIBLE_CARDS = 8;
---

<section class="roadmap" aria-labelledby="roadmap-heading">
  <h2 id="roadmap-heading" class="section-title">Roadmap</h2>

  {
    showLanes ? (
      <ul class="roadmap-lanes">
        {lanes.map((lane) => {
          const visible = lane.items.slice(0, VISIBLE_CARDS);
          const hidden = lane.items.slice(VISIBLE_CARDS);
          return (
            <li class="roadmap-lane">
              <h3 class="lane-label">{lane.label}</h3>
              {lane.items.length > 0 ? (
                <>
                  <ul class="lane-items">
                    {visible.map((item) => (
                      <RoadmapCard {...item} />
                    ))}
                  </ul>
                  {hidden.length > 0 && (
                    <details class="lane-more">
                      <summary class="lane-more-toggle">
                        <span class="lane-more-closed">
                          Show {hidden.length} more
                          <span class="sr-only"> in {lane.label}</span>
                        </span>
                        <span class="lane-more-open">
                          Show fewer
                          <span class="sr-only"> in {lane.label}</span>
                        </span>
                        <span class="lane-more-chevron" aria-hidden="true" />
                      </summary>
                      <ul class="lane-items lane-items-more">
                        {hidden.map((item) => (
                          <RoadmapCard {...item} />
                        ))}
                      </ul>
                    </details>
                  )}
                </>
              ) : (
                <p class="lane-empty">Nothing listed yet.</p>
              )}
            </li>
          );
        })}
      </ul>
    ) : (
      <p class="roadmap-placeholder">
        Roadmap items will appear here once they are added to the app supply sheet.
      </p>
    )
  }
</section>

<style>
  .section-title {
    margin: 0 0 1.25rem;
    font-size: 1.35rem;
  }

  .roadmap-placeholder,
  .lane-empty {
    margin: 0;
    padding: 1rem 1.25rem;
    color: var(--text-muted);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .roadmap-lanes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .roadmap-lane {
    list-style: none;
  }

  @media (min-width: 768px) {
    .roadmap-lanes {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }

  .lane-label {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    color: var(--app-accent, var(--gold));
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .lane-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .lane-more {
    margin-top: 0.65rem;
  }

  .lane-more-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--app-accent, var(--gold));
    background: transparent;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    list-style: none;
  }

  .lane-more-toggle::-webkit-details-marker {
    display: none;
  }

  .lane-more-toggle:hover {
    background: var(--bg-elevated);
    border-color: var(--app-accent, var(--gold-dim));
  }

  .lane-more-toggle:focus-visible {
    outline: 2px solid var(--app-accent, var(--gold));
    outline-offset: 3px;
  }

  .lane-more-open,
  .lane-more[open] .lane-more-closed {
    display: none;
  }

  .lane-more[open] .lane-more-open {
    display: inline;
  }

  .lane-more-chevron {
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
  }

  .lane-more[open] .lane-more-chevron {
    transform: translateY(2px) rotate(-135deg);
  }

  .lane-items-more {
    margin-top: 0.65rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lane-more-chevron {
      transition: transform 0.2s ease;
    }

    .lane-more[open] .lane-items-more {
      animation: lane-more-reveal 0.25s ease-out;
    }
  }

  @keyframes lane-more-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .roadmap-lanes {
      position: relative;
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      scroll-snap-type: x mandatory;
    }

    .roadmap-lane {
      flex: 0 0 min(85%, 280px);
      scroll-snap-align: start;
    }
  }
</style>
