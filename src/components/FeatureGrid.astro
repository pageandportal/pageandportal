---
import { appAssetUrl } from '../lib/apps';
import type { CollectionEntry } from 'astro:content';

interface Props {
  features: CollectionEntry<'apps'>['data']['features'];
}

const { features } = Astro.props;
---

{
  features.length > 0 && (
<section class="features" aria-labelledby="features-heading">
  <h2 id="features-heading" class="section-title">Features</h2>
  <ul class="feature-list">
    {
      features.map((feature, index) => {
        const imageUrl = appAssetUrl(feature.image);
        return (
          <li class="feature-card">
            {imageUrl && (
              <img
                src={imageUrl}
                alt={feature.imageAlt ?? feature.title}
                width="320"
                height="200"
                class="feature-image"
                loading="lazy"
                decoding="async"
              />
            )}
            <div class="feature-body">
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>
  )
}

<style>
  .section-title {
    margin: 0 0 1.25rem;
    font-size: 1.35rem;
  }

  .feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 720px) {
    .feature-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feature-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .feature-image {
    border-radius: 8px;
    object-fit: cover;
    width: 100%;
    max-height: 200px;
  }

  .feature-body h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  .feature-body p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-muted);
  }
</style>
