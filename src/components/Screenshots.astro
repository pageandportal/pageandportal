---
import { appAssetUrl } from '../lib/apps';
import type { CollectionEntry } from 'astro:content';

type AppData = CollectionEntry<'apps'>['data'];

interface Props {
  screenshots: AppData['screenshots'];
  note?: string;
}

const { screenshots, note } = Astro.props;

const shots = screenshots.map((shot) => ({
  ...shot,
  url: appAssetUrl(shot.src),
  portrait: shot.height > shot.width,
}));
type Shot = (typeof shots)[number];

/** Consecutive shots with the same `group` share a row; the viewer still steps through them all. */
const groups: { label?: string; shots: Shot[] }[] = [];
for (const shot of shots) {
  const last = groups.at(-1);
  if (last && last.label === shot.group) last.shots.push(shot);
  else groups.push({ label: shot.group, shots: [shot] });
}

type Row = { shots: Shot[]; kind: 'bento' | 'even' | 'wide'; style: string };

// Portrait rows: up to six in one row on wide screens, and a row-filling count
// (6 → 3 + 3) on mid widths where six would be too narrow. Three stay in one row
// on phones too rather than leaving one on its own.
function portraitRow(row: Shot[]): Row {
  const n = row.length;
  const cols = n <= 6 ? n : ([4, 3, 2].find((c) => n % c === 0) ?? 4);
  const colsMid = [3, 2].find((c) => n % c === 0) ?? 3;
  const colsPhone = n === 3 ? 3 : 2;
  return {
    shots: row,
    kind: 'even',
    style: `--even-cols: ${cols}; --even-cols-mid: ${colsMid}; --even-cols-phone: ${colsPhone}`,
  };
}

// Landscape rows: up to four across on wide screens (four go 2 + 2 on mid widths rather
// than 3 + 1), one per line on phones.
function landscapeRow(row: Shot[]): Row {
  const n = row.length;
  const cols = n <= 4 ? n : 3;
  const colsMid = n === 4 ? 2 : Math.min(n, 3);
  return { shots: row, kind: 'wide', style: `--wide-cols: ${cols}; --wide-cols-mid: ${colsMid}` };
}

function layout(groupShots: Shot[]): Row[] {
  const portraits = groupShots.filter((shot) => shot.portrait);
  const landscapes = groupShots.filter((shot) => !shot.portrait);

  // One or two phone shots side by side, wide shots stacked beside them. The wide column's
  // share is sized so both sides end at about the same height (captions add a little).
  if (portraits.length >= 1 && portraits.length <= 2 && landscapes.length >= 2) {
    const landscapeFr =
      ((portraits[0].height / portraits[0].width) /
        (landscapes.length * (landscapes[0].height / landscapes[0].width))) *
      0.84;
    return [
      {
        shots: [...portraits, ...landscapes],
        kind: 'bento',
        style: `--portrait-cols: ${portraits.length}; --landscape-fr: ${landscapeFr.toFixed(2)}fr; --landscape-rows: ${landscapes.length}`,
      },
    ];
  }

  // Otherwise every phone shot shares one row and the wide shots sit in a row beneath.
  const rows: Row[] = [];
  if (portraits.length > 0) rows.push(portraitRow(portraits));
  if (landscapes.length > 0) rows.push(landscapeRow(landscapes));
  return rows;
}
---

{
  shots.length > 0 && (
    <section class="screenshots" aria-labelledby="screenshots-heading">
      <h2 id="screenshots-heading" class="section-title">Screenshots</h2>
      {note && <p class="screenshots-note">{note}</p>}
      {groups.map((group) => (
        <div class="shot-group">
          {group.label && <h3 class="shot-group-label">{group.label}</h3>}
          {layout(group.shots).map((row) => (
            <ul class:list={['shot-list', row.kind]} style={row.style}>
              {row.shots.map((shot) => (
                <li class:list={['shot', shot.portrait ? 'shot-portrait' : 'shot-landscape']}>
                  <figure>
                    <a class="shot-link" href={shot.url} aria-label={`View larger: ${shot.alt}`}>
                      <img
                        src={shot.url}
                        alt={shot.alt}
                        width={shot.width}
                        height={shot.height}
                        loading="lazy"
                        decoding="async"
                      />
                    </a>
                    {shot.caption && <figcaption>{shot.caption}</figcaption>}
                  </figure>
                </li>
              ))}
            </ul>
          ))}
        </div>
      ))}
      <dialog class="lightbox" aria-label="Screenshot viewer">
        <figure class="lightbox-figure">
          <img class="lightbox-img" src="" alt="" />
          <figcaption class="lightbox-caption"></figcaption>
        </figure>
        <p class="lightbox-count" aria-live="polite"></p>
        <button type="button" class="lightbox-btn lightbox-close" aria-label="Close">×</button>
        {shots.length > 1 && (
          <>
            <button type="button" class="lightbox-btn lightbox-prev" aria-label="Previous screenshot">‹</button>
            <button type="button" class="lightbox-btn lightbox-next" aria-label="Next screenshot">›</button>
          </>
        )}
      </dialog>
    </section>
  )
}

<script>
  for (const section of document.querySelectorAll<HTMLElement>('.screenshots')) {
    const dialog = section.querySelector<HTMLDialogElement>('.lightbox');
    if (!dialog || typeof dialog.showModal !== 'function') continue;

    const links = [...section.querySelectorAll<HTMLAnchorElement>('.shot-link')];
    const img = dialog.querySelector<HTMLImageElement>('.lightbox-img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox-caption')!;
    const count = dialog.querySelector<HTMLElement>('.lightbox-count')!;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (index: number) => {
      current = (index + links.length) % links.length;
      const link = links[current];
      img.src = link.href;
      img.alt = link.querySelector('img')?.alt ?? '';
      const text = link.closest('figure')?.querySelector('figcaption')?.textContent ?? '';
      caption.textContent = text;
      caption.hidden = !text;
      count.textContent = links.length > 1 ? `${current + 1} of ${links.length}` : '';
    };

    links.forEach((link, index) => {
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        opener = link;
        show(index);
        document.documentElement.style.overflow = 'hidden';
        dialog.showModal();
      });
    });

    dialog.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lightbox-prev')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('.lightbox-next')?.addEventListener('click', () => show(current + 1));

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || event.target === dialog.querySelector('.lightbox-figure')) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') dialog.close();
      else if (links.length < 2) return;
      else if (event.key === 'ArrowLeft') show(current - 1);
      else if (event.key === 'ArrowRight') show(current + 1);
    });

    let touchX: number | null = null;
    dialog.addEventListener('touchstart', (event) => {
      touchX = event.touches.length === 1 ? event.touches[0].clientX : null;
    }, { passive: true });
    dialog.addEventListener('touchend', (event) => {
      if (touchX === null || links.length < 2) return;
      const dx = event.changedTouches[0].clientX - touchX;
      touchX = null;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      opener?.focus();
    });
  }
</script>

<style>
  .section-title {
    margin: 0 0 1.25rem;
    font-size: 1.35rem;
  }

  .screenshots-note {
    margin: -0.5rem 0 1.25rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .shot-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .shot-list.even {
    grid-template-columns: repeat(var(--even-cols-phone), minmax(0, 1fr));
  }

  .shot-landscape {
    grid-column: 1 / -1;
  }

  .shot-list + .shot-list {
    margin-top: 1.25rem;
  }

  .shot-group + .shot-group {
    margin-top: 2rem;
  }

  .shot-group-label {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    color: var(--app-accent, var(--gold));
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (min-width: 720px) {
    .shot-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .shot-landscape {
      grid-column: span 2;
    }

    /* Capped so a short row of phone shots is no taller than the ones beside landscapes. */
    .shot-list.even {
      grid-template-columns: repeat(var(--even-cols-mid), minmax(0, 20rem));
    }

    .shot-list.bento {
      grid-template-columns:
        repeat(var(--portrait-cols), minmax(0, 1fr))
        minmax(0, var(--landscape-fr));
    }

    .bento .shot-portrait {
      grid-row: span var(--landscape-rows);
    }

    .bento .shot-landscape {
      grid-column: -2 / -1;
    }

    .shot-list.wide {
      grid-template-columns: repeat(var(--wide-cols-mid), minmax(0, 1fr));
    }

    .wide .shot-landscape {
      grid-column: auto;
    }
  }

  @media (min-width: 1024px) {
    .shot-list.even {
      grid-template-columns: repeat(var(--even-cols), minmax(0, 20rem));
    }

    .shot-list.wide {
      grid-template-columns: repeat(var(--wide-cols), minmax(0, 1fr));
    }
  }

  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .shot-link {
    display: block;
    border-radius: 10px;
    cursor: zoom-in;
  }

  .shot-link:focus-visible {
    outline: 2px solid var(--app-accent, var(--gold));
    outline-offset: 3px;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--app-accent, var(--gold)) 30%, var(--border));
    background: #000;
    transition: border-color 0.15s ease;
  }

  .shot-link:hover img {
    border-color: var(--app-accent, var(--gold));
  }

  .shot figcaption {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .lightbox {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 3.5rem 4.5rem 1rem;
    border: 0;
    background: rgb(0 0 0 / 0.92);
    color: var(--text);
  }

  .lightbox[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox-figure {
    margin: 0;
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .lightbox-img {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 10rem);
    width: auto;
    height: auto;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--app-accent, var(--gold)) 30%, var(--border));
    background: #000;
  }

  .lightbox-caption {
    max-width: 60ch;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .lightbox-count {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .lightbox-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: rgb(22 26 33 / 0.85);
    color: var(--text);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox-btn:hover,
  .lightbox-btn:focus-visible {
    border-color: var(--app-accent, var(--gold));
    color: var(--app-accent, var(--gold));
  }

  .lightbox-close {
    top: 0.75rem;
    right: 0.75rem;
  }

  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-prev {
    left: 0.75rem;
  }

  .lightbox-next {
    right: 0.75rem;
  }

  @media (max-width: 719px) {
    .lightbox {
      padding: 3.5rem 0.75rem 4.25rem;
    }

    .lightbox-img {
      max-height: calc(100dvh - 14rem);
    }

    .lightbox-prev,
    .lightbox-next {
      top: auto;
      bottom: 0.75rem;
      transform: none;
    }
  }
</style>
