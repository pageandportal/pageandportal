---
interface Props {
  title: string;
  description?: string;
  status?: 'planned' | 'in-progress' | 'ready' | 'shipped';
}

const { title, description, status } = Astro.props;

const statusLabels: Record<string, string> = {
  planned: 'planned',
  'in-progress': 'in progress',
  ready: 'ready',
  shipped: 'released',
};
---

<li class="roadmap-card">
  <div class="card-head">
    <span class="card-title">{title}</span>
    {
      status && (
        <span class={`status status-${status}`}>
          <span class="sr-only">Status: </span>
          {statusLabels[status]}
        </span>
      )
    }
  </div>
  {description && <p>{description}</p>}
</li>

<style>
  .roadmap-card {
    padding: 0.85rem 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .card-title {
    font-weight: 600;
    color: var(--text);
  }

  .roadmap-card p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .status {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .status-in-progress {
    color: var(--app-accent, var(--gold));
    border-color: var(--app-accent, var(--gold-dim));
  }

  .status-ready {
    color: #9dc0ff;
    border-color: #41608f;
  }

  .status-shipped {
    color: #8bc49a;
    border-color: #3d5c45;
  }
</style>
