---
import { ANALYTICS, isAnalyticsEnabled } from '../config/analytics';
---

{
  isAnalyticsEnabled() && (
    <>
      <link rel="preconnect" href="https://plausible.io" />
      <script
        defer
        data-domain={ANALYTICS.plausibleDomain}
        src="https://plausible.io/js/script.js"
      />
    </>
  )
}
