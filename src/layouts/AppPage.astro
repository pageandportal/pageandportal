---
import BaseLayout from './BaseLayout.astro';
import AppHero from '../components/AppHero.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Roadmap from '../components/Roadmap.astro';
import DonateSection from '../components/DonateSection.astro';
import { isDonateEnabled } from '../config/donate';
import AppLegalFooter from '../components/AppLegalFooter.astro';
import type { AppEntry } from '../lib/apps';

interface Props {
  entry: AppEntry;
}

const { entry } = Astro.props;
const { data } = entry;

const accentStyle =
  data.accentColor || data.accentColorSecondary
    ? {
        '--app-accent': data.accentColor ?? 'var(--gold)',
        '--app-accent-secondary': data.accentColorSecondary ?? data.accentColor ?? 'var(--gold-dim)',
      }
    : undefined;
---

<BaseLayout title={data.name} description={data.tagline}>
  <article class="app-page" style={accentStyle}>
    <AppHero entry={entry} />
    <div class="app-body container">
      <FeatureGrid features={data.features} />
      <Roadmap entry={entry} />
      {isDonateEnabled() && <DonateSection entry={entry} />}
      <AppLegalFooter entry={entry} />
    </div>
  </article>
</BaseLayout>

<style>
  .app-page {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .app-body {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
</style>
