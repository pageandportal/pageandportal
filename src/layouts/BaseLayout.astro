---
import '../styles/global.css';
import SkipLink from '../components/SkipLink.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ANALYTICS, hasGoogleAnalytics } from '../config/analytics';
import { SITE } from '../config/site';
import { siteUrl } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Path under public/ or full URL for Open Graph / Twitter image */
  ogImage?: string;
  /** Use on 404.html so assets resolve when GitHub serves it for nested bad URLs. */
  useAssetBase?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = 'brand/studio-icon.png',
  useAssetBase = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = siteUrl(ogImage, Astro.site);
const fontHref =
  'https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;600&display=swap';
const gaId = ANALYTICS.googleAnalyticsMeasurementId;
const enableAnalytics = import.meta.env.PROD && hasGoogleAnalytics();
const gaInitScript = enableAnalytics
  ? `window.dataLayer = window.dataLayer || [];
function gtag(){window.dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${gaId}');`
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {useAssetBase && <base href={base} />}
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0f12" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/png" href={`${base}brand/studio-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href={fontHref} as="style" />
    <link rel="stylesheet" href={fontHref} />
    {
      enableAnalytics && (
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      )
    }
    {enableAnalytics && <script is:inline set:html={gaInitScript} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <SkipLink />
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  main {
    padding-block: 2rem 4rem;
    min-height: 60vh;
  }

  main:focus {
    outline: none;
  }
</style>
