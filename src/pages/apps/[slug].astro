---
import BaseLayout from '../../layouts/BaseLayout.astro';
import inventory from '../../../apps.inventory.json';

export function getStaticPaths() {
  return inventory.apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

const { app } = Astro.props;
const base = import.meta.env.BASE_URL;
const iconMap: Record<string, string> = {
  'commander-vault': `${base}apps/commander-vault/icon.png`,
};
const iconUrl = iconMap[app.slug];
const statusLabel = app.status.replace(/-/g, ' ');
---

<BaseLayout title={app.name} description={app.tagline}>
  <article class="container app-stub">
    <a class="back" href={base}>← Back to home</a>

    <header class="app-header">
      {
        iconUrl ? (
          <img src={iconUrl} alt="" width="96" height="96" class="app-icon" />
        ) : (
          <div class="app-icon-fallback" aria-hidden="true">{app.name.charAt(0)}</div>
        )
      }
      <div>
        <span class="badge">{statusLabel}</span>
        <h1>{app.name}</h1>
        {'subtitle' in app && app.subtitle && <p class="subtitle">{app.subtitle}</p>}
        <p class="tagline">{app.tagline}</p>
      </div>
    </header>

    <p class="notice">
      Full app page coming in a later update — features, roadmap, and legal links will appear here.
    </p>
  </article>
</BaseLayout>

<style>
  .app-stub {
    max-width: 52rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--text-muted);
  }

  .back:hover {
    color: var(--gold);
  }

  .app-header {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    margin-bottom: 2rem;
  }

  .app-icon {
    border-radius: 16px;
    flex-shrink: 0;
  }

  .app-icon-fallback {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-serif);
    font-size: 2.25rem;
    color: var(--gold);
    background: rgb(197 160 89 / 10%);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .app-header h1 {
    margin: 0.5rem 0 0.25rem;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
  }

  .subtitle {
    margin: 0 0 0.35rem;
    color: var(--gold);
    font-weight: 500;
  }

  .tagline {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .notice {
    padding: 1rem 1.25rem;
    color: var(--text-muted);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
</style>
